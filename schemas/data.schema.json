{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zipper thread color data",
  "description": "Maps zipper SKUs to compatible thread color codes, and provides zipper and thread reference lists.",
  "type": "object",
  "required": ["mappings", "zippers", "threads"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "description": "List of zipper-to-thread-color mappings.",
      "items": {
        "type": "object",
        "required": ["zipper", "threadColors"],
        "additionalProperties": false,
        "properties": {
          "zipper": {
            "type": "string",
            "description": "The SKU of the zipper."
          },
          "threadColors": {
            "type": "object",
            "description": "A map of thread IDs to the recommended color code for that thread.",
            "minProperties": 1,
            "propertyNames": {
              "enum": ["gtsa", "gtda", "gtdp", "jtd", "spt"]
            },
            "properties": {
              "gtsa": {
                "type": "string",
                "description": "Gutermann Sew-All thread color code.",
                "pattern": "^[0-9]+$"
              },
              "gtda": {
                "type": "string",
                "description": "Gutermann Mara 100 thread color code.",
                "pattern": "^gtda[a-zA-Z0-9]+$"
              },
              "gtdp": {
                "type": "string",
                "description": "Gutermann Mara 70 thread color code.",
                "pattern": "^gtdp[a-zA-Z0-9]+$"
              },
              "jtd": {
                "type": "string",
                "description": "Perform-X Tex 60 thread color code.",
                "pattern": "^jtd[a-zA-Z0-9]+$"
              },
              "spt": {
                "type": "string",
                "description": "Coats & Clark S910 Dual Duty XP thread color code.",
                "pattern": "^spt[0-9]+$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "zippers": {
      "type": "array",
      "description": "Reference list of all available zipper products.",
      "items": {
        "type": "object",
        "required": ["id", "color", "link"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "SKU for the zipper, matching the 'zipper' field in mappings."
          },
          "color": {
            "type": "string",
            "description": "Human-readable color name and/or color code (e.g. 'Navy/560')."
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "URL to the product page for this SKU."
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "description": "Reference list of supported thread brands/types.",
      "items": {
        "type": "object",
        "required": ["id", "name", "imageFolder", "link"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Short identifier for the thread type, used as keys in threadColors (e.g. 'gtda', 'spt').",
            "enum": ["gtsa", "gtda", "gtdp", "jtd", "spt"]
          },
          "name": {
            "type": "string",
            "description": "Full product name of the thread."
          },
          "imageFolder": {
            "type": "string",
            "description": "Folder name where thread spool images are stored."
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "URL to the product page for this thread type."
          }
        }
      }
    }
  }
}
