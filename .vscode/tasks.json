{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Wrangler Dev",
      "type": "shell",
      "command": "pnpm wrangler dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "wrangler",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*wrangler dev.*$",
          "endsPattern": "\\[wrangler:info\\] Ready on"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    }
  ]
}
